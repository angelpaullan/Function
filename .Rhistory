randomfun <- function(n) {
u <- runif(n)
sapply(u, function(u)
uniroot(
function(x) 1/2 + (35/32) *
(x - x^3 + (3/5)*x^5 - (1/7)*x^7) - u,
interval = c(-1, 1)
)$root
)
}
randomfun(10000)
muestra <- randomfun(10000)
hist(muestra)
curve(dfun(x))
curve(dfun(x),add = TRUE)
