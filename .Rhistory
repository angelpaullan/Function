# ===============================
# 11. PRUEBA CHI-CUADRADO
# ===============================
pr_bond_ajus <- function(fa, probs) {
n <- sum(fa)
E <- n * probs
STATISTIC <- sum((fa - E)^2 / E)
PARAMETER <- length(fa) - 1
PVAL <- pchisq(STATISTIC, PARAMETER, lower.tail = FALSE)
list(
X2 = STATISTIC,
gl = PARAMETER,
p_value = PVAL
)
}
resultado<- pr_bond_ajus(fa, probabilidades)
as.data.frame(resultado)
#' @examples
#' # Evaluate the density at a single point
#' pf(1)
#'
#' # Evaluate the density at a sequence of points
#' x <- seq(0, 2, 0.1)
#' plot(x, pf(x), type = "l", col = "red", lwd = 2,
#'      main = "Density function f(x)", ylab = "f(x)")
#'
#' @export
pf <- function(x) {
ifelse(x >= 0 & x <= 2, (3/4) * x * (2 - x)^2, 0)
}
pf(100)
pf(10)
pf(0.5
)
