library(Function)
independencia <- function(u, h) {
n <- length(u)
if (h >= n) stop("h debe ser estrictamente menor a n - 1")
# Desviaciones respecto a la media
u_cent <- u - mean(u)
den <- sum(u_cent^2)
# Cálculo vectorizado de r_k para k = 1, ..., h
rk <- sapply(1:h, function(k) sum(u_cent[(k + 1):n] * u_cent[1:(n - k)]) / den)
# Estadístico Q de Ljung-Box
Q <- n * (n + 2) * sum((rk^2) / (n - (1:h)))
# Grados de libertad y p-valor
p_valor <- pchisq(Q, df = h, lower.tail = FALSE)
return(list(
Estadistico_Q = Q,
Grados_Libertad = h,
P_Valor = p_valor
))
}
muestra <- runif(10)
hist(muestra)
