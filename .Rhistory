print(resultado)
fun_densidad <- function(x) { ifelse(x >= (-1) & x <= 1, (35/32) * (1 - x^2)^3, 0) }
fun_cdf <- function(x) {
sapply(x, function(xi) {
if(xi <= -1) return(0)
if(xi >= 1) return(1)
integrate(function(t) fun_densidad(t), -1, xi)$value
})
}
fun_random <- function(n) {
muestra <- numeric(n)
i <- 1
while(i <= n) {
x <- runif(1, -1, 1)   # candidate
u <- runif(1)          # uniform for acceptance
if(u <= fun_densidad(x) / (35/32)) {
muestra[i] <- x
i <- i + 1
}
}
return(muestra)
}
fun_validador <- function(muestra) {
ks <- ks.test(muestra, fun_cdf)
return(ks)
}
