Chisq_f <- function(sample) {
# Definir cortes en el soporte [-1,1]
x <- seq(-1, 1, by = 0.25)
# Probabilidades teóricas en cada intervalo usando tu CDF pf()
fx <- diff(pf(x))
# Frecuencias observadas con tabla de frecuencias
t <- fdt(sample, start = -1, end = 1, h = 0.25)
fa <- t$table$f
# Prueba chi-cuadrado
res <- chisq.test(x = fa, p = fx)
# Resultado resumido
c("statistic" = as.numeric(res$statistic),
"df"        = as.numeric(res$parameter),
"p.val"     = res$p.value)
}
Chisq_f(muestra)
muestra <- randomfun(10000)
Chisq_f(muestra)
pf <- function(x) {
ifelse(x < -1, 0,
ifelse(x <= 1,
1/2 + (35/32) * (x - x^3 + (3/5) * x^5 - (1/7) * x^7),
1))
}
randomfun <- function(n) {
u <- runif(n)
sapply(u, function(u)
uniroot(
function(x) 1/2 + (35/32) *
(x - x^3 + (3/5)*x^5 - (1/7)*x^7) - u,
interval = c(-1, 1)
)$root
)
}
muestra <- randomfun(10000)
hist(muestra,probability = TRUE)
curve((35/32)*(1-x^2)^3,
from = -1, to = 1,
add = TRUE)
Chisq_f <- function(sample) {
# Definir cortes en el soporte [-1,1]
x <- seq(-1, 1, by = 0.25)
# Probabilidades teóricas en cada intervalo usando tu CDF pf()
fx <- diff(pf(x))
# Frecuencias observadas con tabla de frecuencias
t <- fdt(sample, start = -1, end = 1, h = 0.25)
fa <- t$table$f
# Prueba chi-cuadrado
res <- chisq.test(x = fa, p = fx)
# Resultado resumido
c("statistic" = as.numeric(res$statistic),
"df"        = as.numeric(res$parameter),
"p.val"     = res$p.value)
}
Chisq_f(muestra)
Chisq_f <- function(sample){
cortes <- seq(-1, 1, by = 0.25)
fa <- table(cut(sample,
breaks = cortes,
include.lowest = TRUE))
fx <- diff(pf(cortes))
res <- chisq.test(as.numeric(fa), p = fx)
c(statistic = res$statistic,
df = res$parameter,
p.value = res$p.value)
}
Chisq_f(muestra)
